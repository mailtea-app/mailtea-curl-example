# run.sh sources this file as shell, so quote anything containing spaces.

# Your Mailtea API key: https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for local dev or a self-hosted Mailtea. Omit in production and
# the scripts fall back to https://api.mailtea.app.
# MAILTEA_API_BASE_URL=https://mailtea.internal.example

# Must be an address on a domain you have verified in Mailtea.
MAILTEA_FROM="Acme <hello@acme.com>"

# Where to send. Never use @example.com — it has no MX record.
MAILTEA_TO=reader@yourdomain.com

# Optional; the scripts default to "Hello from curl".
# MAILTEA_SUBJECT="Hello from curl"

# Optional; when to send send-scheduled.sh's message, as an RFC 3339 timestamp
# in UTC. A command-line argument beats this, and unset means an hour from now.
# MAILTEA_SCHEDULED_AT=2026-09-01T09:00:00Z
